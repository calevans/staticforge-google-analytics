{
    "name": "calevans/staticforge-google-analytics",
    "description": "StaticForge Feature: GoogleAnalytics",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Calevans\\StaticForgeGoogleAnalytics\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Calevans\\StaticForgeGoogleAnalytics\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.5",
        "eicc/staticforge": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "extra": {
        "staticforge": {
            "feature": "Calevans\\StaticForgeGoogleAnalytics\\Feature"
        }
    },
    "config": {
        "allow-plugins": {
            "eicc/staticforge-installer": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "cs": "phpcs"
    }
}
