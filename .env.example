# Your GA4 measurement ID (G-XXXXXXXXXX) or GTM container ID (GTM-XXXXXXX).
# Leave empty to fall back to google_analytics.tracking_id in siteconfig.yaml.
GOOGLE_ANALYTICS_ID=""

# Optional kill switch. Set to false/0/off/no to force-disable injection
# regardless of siteconfig.yaml — useful in a staging or local .env.
#GOOGLE_ANALYTICS_ENABLED=false
